{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "resolveJsonModule": true
  },
  "include": [
    "ui/src",
    "tests/browser",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
